# MongoDB Atlas connection string
MONGODB_URI=

# NextAuth: generate a secret with `openssl rand -base64 32`
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Public site URL used for SEO (sitemap, Open Graph) and email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Admin panel: comma-separated emails that become admins when they sign in
# with Google or GitHub (the email must match that account's email)
ADMIN_EMAILS=

# Order and password-reset emails (https://resend.com). Leave RESEND_API_KEY
# empty to skip emails; the store still works.
RESEND_API_KEY=
EMAIL_FROM=Mewazar <orders@your-domain.com>
# Where new-order alerts and contact messages go (defaults to the first ADMIN_EMAILS entry)
ADMIN_NOTIFY_EMAIL=

# Optional: shared rate limiting across server instances (https://upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
